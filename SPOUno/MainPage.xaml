<Page x:Class="SPOUno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" Spacing="12" MaxWidth="420">
        <TextBlock Text="Первая форма на C#" FontSize="24" />
        <TextBox x:Name="NameInput" Header="Ваше имя" />
        <Button Content="Поприветствовать" Click="OnGreetClick" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</Page>
